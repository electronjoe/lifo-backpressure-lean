  "edition": "arXiv:1008.4895v2",
  "citation_details": "3 Apr 2011 (arXiv preprint; journal version in IEEE/ACM Trans. Netw. 21(3):831-844, 2012)",
  "revision": "1008.4895v2",
  "publication": "https://arxiv.org/abs/1008.4895v2",
  "paper_overview": "This paper proves that combining the standard Backpressure (MaxWeight / QLA) algorithm with a Last-In-First-Out (LIFO) queueing discipline achieves a time-average utility within O(1/V) of optimal while keeping the average delay of all but an O(1/V^{log V}) fraction of traffic bounded by O([log V]^2) under general finite-state Markovian network dynamics, without requiring statistical knowledge of the network randomness or pre-estimated Lagrange multipliers. All four inventoried claims are established theorems (no conjectures are stated); Theorems 2 and 3 cite proofs in companion papers bundled under references/.",
  "folio": {
    "short_title": "LIFO-Backpressure",
    "featured_claim": "thm:qlalifo_delay",
    "blurb": "Under LIFO-Backpressure with control parameter V >= 1, all but an O(1/V^{log V}) fraction of arriving packets depart with average delay at most [2D + 2K(log V)^2 + delta_max] / lambda_tilde_j = O([log V]^2).",
    "figure": {
      "path": "assets/fig1-lifo-idea.png",
      "alt": "Simulated single-queue backlog trajectory under Backpressure fluctuating within an O([log V]^2) band around the Theta(V) dual attractor gamma_V^*, paired with a LIFO queue diagram showing arrivals entering and departing inside [Q_Low, Q_High] atop the Theta(V) base backlog.",
      "caption": "Fig. 1. The LIFO-Backpressure Idea: exponential attraction keeps the backlog within an O([log V]^2) band [Q_Low, Q_High] around gamma_V^*, so LIFO serves almost all arriving packets from the top band.",
      "page": 2
    }
  },
